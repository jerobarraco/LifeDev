#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.NotReady.Text
msgctxt ",1AE24FE6BF46458BB01B4274D454E969"
msgid "It seems it's not the right time yet..."
msgstr "It seems it's not the right time yet..."

#. Key:	8F423E1E08364894ADB4A813EEA11485
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.NotUsable.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.NotUsable.Text
msgctxt ",8F423E1E08364894ADB4A813EEA11485"
msgid "Hmm... i can't imagine how to use this."
msgstr "Hmm... i can't imagine how to use this."

#. Key:	D053A0494C254A4F8D028E1DB9F13572
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C01.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C01.Text
msgctxt ",D053A0494C254A4F8D028E1DB9F13572"
msgid "A shirt from one of my siblings."
msgstr "A shirt from one of my siblings."

#. Key:	D9285CFF386F4619B02365901CAE7C9A
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C02.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C02.Text
msgctxt ",D9285CFF386F4619B02365901CAE7C9A"
msgid "Some boxers.\nNot mine though, ugh."
msgstr "Some boxers.\nNot mine though, ugh."

#. Key:	4B8184956E6740C48B9A3924F76FCF6E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C03.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C03.Text
msgctxt ",4B8184956E6740C48B9A3924F76FCF6E"
msgid "A used bra."
msgstr "A used bra."

#. Key:	B5CE9206329C4E548A5CBCFDD8433204
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C04.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Look.C1C04.Text
msgctxt ",B5CE9206329C4E548A5CBCFDD8433204"
msgid "Some smelly dirty socks.\nSucks."
msgstr "Some smelly dirty socks.\nSucks."

#. Key:	D64BD82CF8EC4D848EFFCAFAD469C6E7
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.P00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.P00_T.0.Text
msgctxt ",D64BD82CF8EC4D848EFFCAFAD469C6E7"
msgid "A page torn from a book.\nIt says:"
msgstr "A page torn from a book.\nIt says:"

#. Key:	E1DE6B1C2B384551BA9CE71A2E543CEC
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.P00_T.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.P00_T.1.Text
msgctxt ",E1DE6B1C2B384551BA9CE71A2E543CEC"
msgid "\"She opened her gaze to the world,\nShe saw it as it was;\nAnd it hurted her.\nBleeding she decided to keep going, she learned to become strong,\nAnd discovered that the pain was not eternal.\nThen relieved, she sighed strongly...\nand smiled.\"\n\n- Paula Martinez 07/01/18"
msgstr "\"She opened her gaze to the world,\nShe saw it as it was;\nAnd it hurted her.\nBleeding she decided to keep going, she learned to become strong,\nAnd discovered that the pain was not eternal.\nThen relieved, she sighed strongly...\nand smiled.\"\n\n- Paula Martinez 07/01/18"

#. Key:	E9881275B3404A58AC6B30018510D9F3
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.PZ00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.PZ00_T.0.Text
msgctxt ",E9881275B3404A58AC6B30018510D9F3"
msgid "\"FEAR\"\nMy body feels like it's about to split into pieces, and every piece run into a different direction.\nI want to become really tiny and hide below a furniture so no-one can ever find me.\nTime is running out, and i need to find a way out!"
msgstr "\"FEAR\"\nMy body feels like it's about to split into pieces, and every piece run into a different direction.\nI want to become really tiny and hide below a furniture so no-one can ever find me.\nTime is running out, and i need to find a way out!"

#. Key:	2AE262D808C94B1BA74EB2EA7C6C4403
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.PZ00xC00.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.PZ00xC00.Text
msgctxt ",2AE262D808C94B1BA74EB2EA7C6C4403"
msgid "I wish i understand what is going on.\nEverything is so confusing.\nI don't even know what i want."
msgstr "I wish i understand what is going on.\nEverything is so confusing.\nI don't even know what i want."

#. Key:	D48C9FED913E4D018D4A7D85F89AE274
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_L.Text
msgctxt ",D48C9FED913E4D018D4A7D85F89AE274"
msgid "Sometimes this music box wakes me up.\nUsually on weekends, just when i need to rest."
msgstr "Sometimes this music box wakes me up.\nUsually on weekends, just when i need to rest."

#. Key:	7D563CEC15C04EA2A5E645F60191B61D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_LI.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_LI.Text
msgctxt ",7D563CEC15C04EA2A5E645F60191B61D"
msgid "Maybe i can play that tape here."
msgstr "Maybe i can play that tape here."

#. Key:	A2676655373949B6BDF6663C509A9076
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.0.Text
msgctxt ",A2676655373949B6BDF6663C509A9076"
msgid "[Noise, backwards music, unintelligible words]"
msgstr "[Noise, backwards music, unintelligible words]"

#. Key:	76B7802E9F2041E681E12EC1F66C3B7B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.2.Text
msgctxt ",76B7802E9F2041E681E12EC1F66C3B7B"
msgid "...[noise]...\n\"Can't you see?! You can't do anything right!\"\n...\n\"You never help! You're so selfish!\""
msgstr "...[noise]...\n\"Can't you see?! You can't do anything right!\"\n...\n\"You never help! You're so selfish!\""

#. Key:	0A66B63D501349F2BEC5AAC7DD676519
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.3.Text
msgctxt ",0A66B63D501349F2BEC5AAC7DD676519"
msgid "...[noise]....\n\"You have it easy. All you do is complain. Don't just stay there, and try to help!\" \n....\n\"You can never be relied on! I have to do everything myself.\"\n....\n\"You never do anything useful, you're always doing nothing!\""
msgstr "...[noise]....\n\"You have it easy. All you do is complain. Don't just stay there, and try to help!\" \n....\n\"You can never be relied on! I have to do everything myself.\"\n....\n\"You never do anything useful, you're always doing nothing!\""

#. Key:	1C08F54712C6453FACD9737EB97D3113
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.4.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.4.Text
msgctxt ",1C08F54712C6453FACD9737EB97D3113"
msgid "...[noise]....\n\"Don't cry. You're a big boy now.\"\n....\n\"Why do you blame <b>me</> for everything?!\""
msgstr "...[noise]....\n\"Don't cry. You're a big boy now.\"\n....\n\"Why do you blame <b>me</> for everything?!\""

#. Key:	463A4D5826284A50A71D12633BABF7E1
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.5.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.5.Text
msgctxt ",463A4D5826284A50A71D12633BABF7E1"
msgid "...[noise]...\n\"I can't be running behind you, fixing everything, all the time!\"\n...\n\"I'm breaking my back for all of you, you should be more considerate!\""
msgstr "...[noise]...\n\"I can't be running behind you, fixing everything, all the time!\"\n...\n\"I'm breaking my back for all of you, you should be more considerate!\""

#. Key:	13F75550A5DB453083E5F2BF4D2F95E9
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.6.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.6.Text
msgctxt ",13F75550A5DB453083E5F2BF4D2F95E9"
msgid "...\nThat was weird ...\nSeems like someone recorded mom and dad."
msgstr "...\nThat was weird ...\nSeems like someone recorded mom and dad."

#. Key:	9DCBB6C10FAE45209D763745E5241A82
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.7.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_T.7.Text
msgctxt ",9DCBB6C10FAE45209D763745E5241A82"
msgid "It does sounds creepy.\n...."
msgstr "It does sounds creepy.\n...."

#. Key:	6963E662041742E58E08D65EF8F83E70
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_UL.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.RD00_UL.Text
msgctxt ",6963E662041742E58E08D65EF8F83E70"
msgid "Let's see, i don't think it will have anything interesting if i play it backwards."
msgstr "Let's see, i don't think it will have anything interesting if i play it backwards."

#. Key:	8E0F0D70EF6046DFB3D67308018F5DDF
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.T00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.T00_T.Text
msgctxt ",8E0F0D70EF6046DFB3D67308018F5DDF"
msgid "A music tape from my little sister.\nMy dad said this singer made a pact with the devil.\nThat if you play it in reverse you can hear demonic messages."
msgstr "A music tape from my little sister.\nMy dad said this singer made a pact with the devil.\nThat if you play it in reverse you can hear demonic messages."

#. Key:	618436E2CA1947809572DF2DE0FAB6FA
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.BattsPick.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.BattsPick.Text
msgctxt ",618436E2CA1947809572DF2DE0FAB6FA"
msgid "Hmm...\nIt's good that my brother is not here.\nMaybe this makes us even..."
msgstr "Hmm...\nIt's good that my brother is not here.\nMaybe this makes us even..."

#. Key:	5182B330D1EF4A1CA6593D212809C65F
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C00.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C00.Text
msgctxt ",5182B330D1EF4A1CA6593D212809C65F"
msgid "I need to pick this up quickly before mom comes back.\nIt's not me who leaves everything on the floor!"
msgstr "I need to pick this up quickly before mom comes back.\nIt's not me who leaves everything on the floor!"

#. Key:	556BF2188F1B4A6EB501210163A89456
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C01.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C01.Text
msgctxt ",556BF2188F1B4A6EB501210163A89456"
msgid "This one is from my brother!\nWhy do i have to pick it up?\nHe should pick up his own stuff..."
msgstr "This one is from my brother!\nWhy do i have to pick it up?\nHe should pick up his own stuff..."

#. Key:	6DDA2BFE5CE84782828037F5BCB244CF
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C02.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C02.Text
msgctxt ",6DDA2BFE5CE84782828037F5BCB244CF"
msgid "These are mine!!\nWhat is it doing in here?!\nAnd it's not the first time!\nHave she used them?!"
msgstr "These are mine!!\nWhat is it doing in here?!\nAnd it's not the first time!\nHave she used them?!"

#. Key:	F4F2C0D85A5F42E2BCB35A76AA230DCF
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C03.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C03.Text
msgctxt ",F4F2C0D85A5F42E2BCB35A76AA230DCF"
msgid "What is this doing here?\nI'm getting yelled and it's her fault! Ugh.\nI'll have to put it in my sister's wardrobe."
msgstr "What is this doing here?\nI'm getting yelled and it's her fault! Ugh.\nI'll have to put it in my sister's wardrobe."

#. Key:	74D0E60C944742DA8F8946C28F41E33A
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C04.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C04.Text
msgctxt ",74D0E60C944742DA8F8946C28F41E33A"
msgid "A pair of socks.\nI fixed a hole. \nLooks ugly and it's uncomfortable."
msgstr "A pair of socks.\nI fixed a hole. \nLooks ugly and it's uncomfortable."

#. Key:	97059BE2D83E4F7E95E5189D50813B41
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C1_PICK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.C1_PICK.Text
msgctxt ",97059BE2D83E4F7E95E5189D50813B41"
msgid "<b>\"Whatever Works\"</>\n\"Keep doing what works. Stop what doesn't.\"\n\nThat's what I need now.\nWhat a weird card..."
msgstr "<b>\"Whatever Works\"</>\n\"Keep doing what works. Stop what doesn't.\"\n\nThat's what I need now.\nWhat a weird card..."

#. Key:	92746A44091647068FE8A221D70C5A1E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D00_LCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D00_LCK.Text
msgctxt ",92746A44091647068FE8A221D70C5A1E"
msgid "Seems locked.\nMaybe someone left it locked on the other side.\nAgain."
msgstr "Seems locked.\nMaybe someone left it locked on the other side.\nAgain."

#. Key:	F6489F0F18F64420BBCB2C55E737DB78
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D01_LCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D01_LCK.Text
msgctxt ",F6489F0F18F64420BBCB2C55E737DB78"
msgid "I hate when they come in and wake me up.\nI also need my walkman, no way i'll leave without it."
msgstr "I hate when they come in and wake me up.\nI also need my walkman, no way i'll leave without it."

#. Key:	4BAA503665CA4D538D5757D4A570B55C
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D01_ULCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D01_ULCK.Text
msgctxt ",4BAA503665CA4D538D5757D4A570B55C"
msgid "I hope nothing bad happens..."
msgstr "I hope nothing bad happens..."

#. Key:	2957F4E4E36A48ABA80E20B461B3FFB2
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D02_LCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.D02_LCK.Text
msgctxt ",2957F4E4E36A48ABA80E20B461B3FFB2"
msgid "Seems dangerous outside..."
msgstr "Seems dangerous outside..."

#. Key:	A42EA27786AF4A0F821D7A3C8B919D11
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.DR00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.DR00_T.Text
msgctxt ",A42EA27786AF4A0F821D7A3C8B919D11"
msgid "I don't like going through my siblings drawers.\nBut i've found my stuff in them before."
msgstr "I don't like going through my siblings drawers.\nBut i've found my stuff in them before."

#. Key:	A97049063666447582F172AC4FABF57E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.DR01_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.DR01_T.Text
msgctxt ",A97049063666447582F172AC4FABF57E"
msgid "I'm pretty sure my siblings open my drawers too.\nAnd take my stuff."
msgstr "I'm pretty sure my siblings open my drawers too.\nAnd take my stuff."

#. Key:	2DD0497AB0E743D694791F12831C403E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT00_IC0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT00_IC0.Text
msgctxt ",2DD0497AB0E743D694791F12831C403E"
msgid "I really want to fix this, but i don't think that is the intention of dad or mom."
msgstr "I really want to fix this, but i don't think that is the intention of dad or mom."

#. Key:	B4239128EBA34067A02F9C73572D2DD2
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT00_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT00_L.Text
msgctxt ",B4239128EBA34067A02F9C73572D2DD2"
msgid "Sometimes i wonder what will kill us first.\nThe cold, the carbon monoxide comming in, or the gas pipe that looks like it's going to break."
msgstr "Sometimes i wonder what will kill us first.\nThe cold, the carbon monoxide comming in, or the gas pipe that looks like it's going to break."

#. Key:	A3AB6EFA157843E18C602EECF58E9D02
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT00_T.Text
msgctxt ",A3AB6EFA157843E18C602EECF58E9D02"
msgid "Whoa!\nI forgot it wasn't hanging properly.\nBetter not to touch it."
msgstr "Whoa!\nI forgot it wasn't hanging properly.\nBetter not to touch it."

#. Key:	F792A696D900464395915ADE15F5A0E1
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT01_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.HT01_L.Text
msgctxt ",F792A696D900464395915ADE15F5A0E1"
msgid "No way i'll touch it. It will fall too.\nI don't wanna have yet another argument with my sister."
msgstr "No way i'll touch it. It will fall too.\nI don't wanna have yet another argument with my sister."

#. Key:	42E00B428B824846815552B7A9C22C08
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.0.Text
msgctxt ",42E00B428B824846815552B7A9C22C08"
msgid "(When i woke up that morning.\nI got just that.\n\"Clarity\".)"
msgstr "(When i woke up that morning.\nI got just that.\n\"Clarity\".)"

#. Key:	BF67E4F680BC45EE80C86B015927F4D6
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.1.Text
msgctxt ",BF67E4F680BC45EE80C86B015927F4D6"
msgid "(It seemed absolutely impossible.\nThere was no light at the end of the tunnel, no hope, no faith.\nBut now, I knew what i wanted.)"
msgstr "(It seemed absolutely impossible.\nThere was no light at the end of the tunnel, no hope, no faith.\nBut now, I knew what i wanted.)"

#. Key:	0B01C78F3DF644A7AFFDA4216788B223
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.2.Text
msgctxt ",0B01C78F3DF644A7AFFDA4216788B223"
msgid "I haven't died, yet...\nI am still breathing..."
msgstr "I haven't died, yet...\nI am still breathing..."

#. Key:	2AE2F65DAAC84581B87C21CF8F6958A3
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.3.Text
msgctxt ",2AE2F65DAAC84581B87C21CF8F6958A3"
msgid "That means i can still try one more thing.\nEven if that thing is to wait...\nI can't quit yet.\nI won't have a clear conscience until i have tried everything."
msgstr "That means i can still try one more thing.\nEven if that thing is to wait...\nI can't quit yet.\nI won't have a clear conscience until i have tried everything."

#. Key:	8FD8BECFEAFB4E4F80375E5FA6875CA7
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.4_rem.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.I3.4_rem.Text
msgctxt ",8FD8BECFEAFB4E4F80375E5FA6875CA7"
msgid "(I never imagined that such plead would snowball into a lifelong journey.)"
msgstr "(I never imagined that such plead would snowball into a lifelong journey.)"

#. Key:	8218B3D99C1840C3A5AA679B577C2986
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Inter.UnlockBad.B_Walkman.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Inter.UnlockBad.B_Walkman.Text
msgctxt ",8218B3D99C1840C3A5AA679B577C2986"
msgid "Those are not the batteries i'm looking for."
msgstr "Those are not the batteries i'm looking for."

#. Key:	8133306930714EDCBEBE962F2297DB63
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0_C03.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0_C03.Text
msgctxt ",8133306930714EDCBEBE962F2297DB63"
msgid "No way! This belongs to my sister.\nI hate cleaning others' mess, but i should put it in her wardrobe.\nOtherwise mom will yell at me anyways."
msgstr "No way! This belongs to my sister.\nI hate cleaning others' mess, but i should put it in her wardrobe.\nOtherwise mom will yell at me anyways."

#. Key:	24EB2D36505E401885756083A744AFA9
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0D.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0D.Text
msgctxt ",24EB2D36505E401885756083A744AFA9"
msgid "Better hurry..."
msgstr "Better hurry..."

#. Key:	C6E58B5B214948458F34BC88CDB861BF
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0T.Text
msgctxt ",C6E58B5B214948458F34BC88CDB861BF"
msgid "Done!\nI'm sick of this."
msgstr "Done!\nI'm sick of this."

#. Key:	5D26E04DA1DE4BD3A2E66972518BADCA
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0TB.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C0TB.Text
msgctxt ",5D26E04DA1DE4BD3A2E66972518BADCA"
msgid "Here's where i can put the clothes from me and my brother.\nAt least so that mom don't see them on the floor."
msgstr "Here's where i can put the clothes from me and my brother.\nAt least so that mom don't see them on the floor."

#. Key:	8634923B51374064BFB6E9C111A58238
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C1D.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C1D.Text
msgctxt ",8634923B51374064BFB6E9C111A58238"
msgid "Yikes, i don't wanna touch this stuff."
msgstr "Yikes, i don't wanna touch this stuff."

#. Key:	FEE6979E38B24372946109A1C0E40397
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C1T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C1T.Text
msgctxt ",FEE6979E38B24372946109A1C0E40397"
msgid "Why do i have to clean for her?"
msgstr "Why do i have to clean for her?"

#. Key:	BB1C7A2AB9614F66824D20B1D1358570
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C1TB.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.IS_C1TB.Text
msgctxt ",BB1C7A2AB9614F66824D20B1D1358570"
msgid "I can stuff her clothes here."
msgstr "I can stuff her clothes here."

#. Key:	F9F76C1A77DA4456AA12F3E92FF9B40A
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.BadTarget.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.BadTarget.Text
msgctxt ",F9F76C1A77DA4456AA12F3E92FF9B40A"
msgid "Those two don't mix.\nI can't use that with that."
msgstr "Those two don't mix.\nI can't use that with that."

#. Key:	AFEA62F9E1774B31934FD08136D2FE90
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.NoTarget.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.NoTarget.Text
msgctxt ",AFEA62F9E1774B31934FD08136D2FE90"
msgid "Use it with what?\nNothing's there."
msgstr "Use it with what?\nNothing's there."

#. Key:	A8B16DA0193D4953AE10774DBCCED421
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.NotReady.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.NotReady.Text
msgctxt ",A8B16DA0193D4953AE10774DBCCED421"
msgid "It seems it's not ready yet..."
msgstr "It seems it's not ready yet..."

#. Key:	AF324BA4B44941679E72F1E3C5FBAA9A
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.NotUsable.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Fail.NotUsable.Text
msgctxt ",AF324BA4B44941679E72F1E3C5FBAA9A"
msgid "Hmm... i can't imagine how to use this."
msgstr "Hmm... i can't imagine how to use this."

#. Key:	C637989BD87D49E6BF49C72CC7E5E6E8
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Look.C1C03.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.Item.Look.C1C03.Text
msgctxt ",C637989BD87D49E6BF49C72CC7E5E6E8"
msgid "My sister's bra.\nShould be on her room."
msgstr "My sister's bra.\nShould be on her room."

#. Key:	4561302EEB6A4079B7F00E1F44FC7FB4
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.0.Text
msgctxt ",4561302EEB6A4079B7F00E1F44FC7FB4"
msgid "But what if trying to kill yourself doesn't end it?\nOr there are other consequences?"
msgstr "But what if trying to kill yourself doesn't end it?\nOr there are other consequences?"

#. Key:	FE6568A7EDE541F4A7BC5D58FA070C11
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.1.Text
msgctxt ",FE6568A7EDE541F4A7BC5D58FA070C11"
msgid "I don't kill myself just to not give them the excuse to say that I'm weak, \nand everything is my fault."
msgstr "I don't kill myself just to not give them the excuse to say that I'm weak, \nand everything is my fault."

#. Key:	D6A29D5F18BC4440B25DA500F41FB1FD
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.2.Text
msgctxt ",D6A29D5F18BC4440B25DA500F41FB1FD"
msgid "Well, you haven't died yet, right?\nMaybe you can try something."
msgstr "Well, you haven't died yet, right?\nMaybe you can try something."

#. Key:	D6E693EFB34E4CCEA29B91772A73755E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.3.Text
msgctxt ",D6E693EFB34E4CCEA29B91772A73755E"
msgid "Like what?\nI tried everything!\nAll I can do is just wait...\nIn this <b>hell</>."
msgstr "Like what?\nI tried everything!\nAll I can do is just wait...\nIn this <b>hell</>."

#. Key:	2A52707AD48F4046810AA7C1B89013A6
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.4.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.0.4.Text
msgctxt ",2A52707AD48F4046810AA7C1B89013A6"
msgid "But if I die they'll use it to play the victim, anyway.\nLike always..."
msgstr "But if I die they'll use it to play the victim, anyway.\nLike always..."

#. Key:	C1EA30CC4D084D8CB2B7D444FC778B1F
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.1.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.1.0.Text
msgctxt ",C1EA30CC4D084D8CB2B7D444FC778B1F"
msgid "I have to do everything to get out.\nDo you know how?"
msgstr "I have to do everything to get out.\nDo you know how?"

#. Key:	AC723045BBCC403E9DCA58ABB9BC5347
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.1.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.1.2.Text
msgctxt ",AC723045BBCC403E9DCA58ABB9BC5347"
msgid "There's no way out..."
msgstr "There's no way out..."

#. Key:	8552CA671D3D43AEBA5C03D8B5E93D4C
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.1.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.1.3.Text
msgctxt ",8552CA671D3D43AEBA5C03D8B5E93D4C"
msgid "As always, I'll have to do everything myself.\nCome, let's get out."
msgstr "As always, I'll have to do everything myself.\nCome, let's get out."

#. Key:	9D430974B4AF4CC9BD63199335EECCE1
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.IB.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.IB.Text
msgctxt ",9D430974B4AF4CC9BD63199335EECCE1"
msgid "That won't help at all."
msgstr "That won't help at all."

#. Key:	5550952272A14F5A9D1288C61003DA1D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.N01.L.Text
msgctxt ",5550952272A14F5A9D1288C61003DA1D"
msgid "I wish i could do something,\nbut maybe i should stay away..."
msgstr "I wish i could do something,\nbut maybe i should stay away..."

#. Key:	37D2CC0E6B05441B9616BFCA74CF401F
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P00_T.0.Text
msgctxt ",37D2CC0E6B05441B9616BFCA74CF401F"
msgid "A page torn from a book.\nIt says:"
msgstr "A page torn from a book.\nIt says:"

#. Key:	D6C09AE7255443398707D1A447B17818
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P00_T.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P00_T.1.Text
msgctxt ",D6C09AE7255443398707D1A447B17818"
msgid "\"She opened her gaze to the world,\nShe saw it as it was;\nAnd it hurted her.\nBleeding she decided to keep going, she learned to become strong;\nAnd discovered that the pain was not eternal.\nThen relieved, she sighed strongly...\nand smiled.\"\n\nPaula Martinez - 07/01/18"
msgstr "\"She opened her gaze to the world,\nShe saw it as it was;\nAnd it hurted her.\nBleeding she decided to keep going, she learned to become strong;\nAnd discovered that the pain was not eternal.\nThen relieved, she sighed strongly...\nand smiled.\"\n\nPaula Martinez - 07/01/18"

#. Key:	1C40548AE71240F78A617B3B20541381
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P01_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P01_T.0.Text
msgctxt ",1C40548AE71240F78A617B3B20541381"
msgid "It seems a page from a poem's book that says:"
msgstr "It seems a page from a poem's book that says:"

#. Key:	558A41223EC441FB8C797DE207DB7130
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P01_T.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.P01_T.1.Text
msgctxt ",558A41223EC441FB8C797DE207DB7130"
msgid "\"While our body stops\nOur mind starts racing,\nLeaving us restless and breathless.\nLet's silence senseless thoughts,\nThoughts that hurt,\nThoughts so empty.\nAnd let's seize this opportunity\nTo meet again with ourselves.\nCultivating our good qualities,\nAdmiting our half-lights,\nIlluminating our darkest side,\nRescuing our lost humanity,\nReblooming the true worth and meaning of life.\"\n\nPaula Martinez - 01/04/20"
msgstr "\"While our body stops\nOur mind starts racing,\nLeaving us restless and breathless.\nLet's silence senseless thoughts,\nThoughts that hurt,\nThoughts so empty.\nAnd let's seize this opportunity\nTo meet again with ourselves.\nCultivating our good qualities,\nAdmiting our half-lights,\nIlluminating our darkest side,\nRescuing our lost humanity,\nReblooming the true worth and meaning of life.\"\n\nPaula Martinez - 01/04/20"

#. Key:	C1926DC3586B42ED94C152DED1E86860
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.PZ01_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.PZ01_T.0.Text
msgctxt ",C1926DC3586B42ED94C152DED1E86860"
msgid "\"ANGER\"\nI feel like i'm going to explode!\nThere's a pain in my stomach.\nI want to break something, or yell, but i can't!"
msgstr "\"ANGER\"\nI feel like i'm going to explode!\nThere's a pain in my stomach.\nI want to break something, or yell, but i can't!"

#. Key:	5D1FF5B017364547851E4CC093500A96
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.PZ01xC00.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.PZ01xC00.Text
msgctxt ",5D1FF5B017364547851E4CC093500A96"
msgid "I feel stuck all the time.\nI'm sick of it.\nI really need something to be able to break free."
msgstr "I feel stuck all the time.\nI'm sick of it.\nI really need something to be able to break free."

#. Key:	53C5544008AB4ECFAFB0B3B0D03B2F46
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.RD01_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.RD01_L.Text
msgctxt ",53C5544008AB4ECFAFB0B3B0D03B2F46"
msgid "When it's not the other radio, this also wakes me up early.\nAnother reason to argue with my siblings.\nI wish i could do something.\nBut my sister was like \"whatever\"."
msgstr "When it's not the other radio, this also wakes me up early.\nAnother reason to argue with my siblings.\nI wish i could do something.\nBut my sister was like \"whatever\"."

#. Key:	A553D44A72D44E608A0D315C58E8A881
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.0.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.0.0.Text
msgctxt ",A553D44A72D44E608A0D315C58E8A881"
msgid "Ghosts!\nI have to run again!!"
msgstr "Ghosts!\nI have to run again!!"

#. Key:	862C96161C1C45E485F2E77D2F334C13
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.0.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.0.1.Text
msgctxt ",862C96161C1C45E485F2E77D2F334C13"
msgid "I'm trapped!\nI'm sick of running!\nBut what can i..?"
msgstr "I'm trapped!\nI'm sick of running!\nBut what can i..?"

#. Key:	6A248DB335264002AC4D662371832FC3
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.0.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.0.2.Text
msgctxt ",6A248DB335264002AC4D662371832FC3"
msgid "It is stupid to use the walkman,\nbut it's the only thing i have."
msgstr "It is stupid to use the walkman,\nbut it's the only thing i have."

#. Key:	7CBF6F78D8524BC9AE3473B50A1B6063
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.1.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.1.0.Text
msgctxt ",7CBF6F78D8524BC9AE3473B50A1B6063"
msgid "Ohhh no! I <b>knew</> it will make it worse!!\nThey will destroy everything!"
msgstr "Ohhh no! I <b>knew</> it will make it worse!!\nThey will destroy everything!"

#. Key:	453B8BBF602B4513B60B353BD3A0DB21
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.1.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S2.1.1.Text
msgctxt ",453B8BBF602B4513B60B353BD3A0DB21"
msgid "Why does <b>everything, always,</> go wrong!\n<b>Why?!</>"
msgstr "Why does <b>everything, always,</> go wrong!\n<b>Why?!</>"

#. Key:	EA7D46288B89436E816D94CDF7A749D4
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S3.0.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S3.0.0.Text
msgctxt ",EA7D46288B89436E816D94CDF7A749D4"
msgid "I hate them!\nI hate everyone, I hate my life, I hate being here, I hate everything.\nI hate being like this, I hate myself.\nWhy don't I die once and for all?!"
msgstr "I hate them!\nI hate everyone, I hate my life, I hate being here, I hate everything.\nI hate being like this, I hate myself.\nWhy don't I die once and for all?!"

#. Key:	15249FF2709044D792F9E4AA038B2899
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S3.0.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.S3.0.1.Text
msgctxt ",15249FF2709044D792F9E4AA038B2899"
msgid "I should kill myself and end it all."
msgstr "I should kill myself and end it all."

#. Key:	A1D9750405B94FF8B1BBC4BA5F0F0A30
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.T1_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.T1_T.Text
msgctxt ",A1D9750405B94FF8B1BBC4BA5F0F0A30"
msgid "After weeks looking for it!\nSurely she left it there to hide the fact that she takes my walkman..."
msgstr "After weeks looking for it!\nSurely she left it there to hide the fact that she takes my walkman..."

#. Key:	2350D31DDB45447DA92A7DDC01541A7D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.TV00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.TV00_T.Text
msgctxt ",2350D31DDB45447DA92A7DDC01541A7D"
msgid "I hate this.\nI can hear it from my bed room while trying to sleep.\nI wish it will just stop working."
msgstr "I hate this.\nI can hear it from my bed room while trying to sleep.\nI wish it will just stop working."

#. Key:	344A288066D345079DFE0B56E9574A76
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.TV00xBatts.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.TV00xBatts.Text
msgctxt ",344A288066D345079DFE0B56E9574A76"
msgid "The tv doesn't use batteries.\nIt would be nice though, so it runs out of them."
msgstr "The tv doesn't use batteries.\nIt would be nice though, so it runs out of them."

#. Key:	A1341E0A4E484E428B524319AE0E6F82
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.W0_LCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.W0_LCK.Text
msgctxt ",A1341E0A4E484E428B524319AE0E6F82"
msgid "I had to lock it, so that they don't steal my stuff.\nI have to change where i hide the key often,\nso i don't remember where it is now...."
msgstr "I had to lock it, so that they don't steal my stuff.\nI have to change where i hide the key often,\nso i don't remember where it is now...."

#. Key:	902C3CA82C7046CFB2FCEB54D713F930
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.W0_LCKIT.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.W0_LCKIT.Text
msgctxt ",902C3CA82C7046CFB2FCEB54D713F930"
msgid "I had to lock it, so that they don't steal my stuff.\nI can open it with the key i have."
msgstr "I had to lock it, so that they don't steal my stuff.\nI can open it with the key i have."

#. Key:	0AE4B2B6884644B493029F69F4E5521C
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.W0_ULCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.W0_ULCK.Text
msgctxt ",0AE4B2B6884644B493029F69F4E5521C"
msgid "Finally.\nGotta be quick.\nBefore they see me."
msgstr "Finally.\nGotta be quick.\nBefore they see me."

#. Key:	B2F4233F52664E059A391C14B3FD01A6
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.WM_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.WM_L.Text
msgctxt ",B2F4233F52664E059A391C14B3FD01A6"
msgid "It has no batteries, i can't use it.\nIt's always hard to find batteries, someone always takes them."
msgstr "It has no batteries, i can't use it.\nIt's always hard to find batteries, someone always takes them."

#. Key:	C539200759294E449107B1EC9A6F4601
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.WM_LI.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/01/Diags01.Diags01.WM_LI.Text
msgctxt ",C539200759294E449107B1EC9A6F4601"
msgid "I just have to put the batteries in it."
msgstr "I just have to put the batteries in it."

#. Key:	64162BC043404977ACC0A58A78CE32A6
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.BattsPick.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.BattsPick.Text
msgctxt ",64162BC043404977ACC0A58A78CE32A6"
msgid "Used batteries.\nMaybe i could listen one song with them."
msgstr "Used batteries.\nMaybe i could listen one song with them."

#. Key:	9C72234419CB44CF81A4D709D6D3B4B4
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.C2S3.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.C2S3.0.Text
msgctxt ",9C72234419CB44CF81A4D709D6D3B4B4"
msgid "(I don't wanna hear anyone anymore.\nI'll put my headphones while i finish preparing.)"
msgstr "(I don't wanna hear anyone anymore.\nI'll put my headphones while i finish preparing.)"

#. Key:	8FD9FE00263E49AE93421FE4DE572204
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.Cal00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.Cal00_T.0.Text
msgctxt ",8FD9FE00263E49AE93421FE4DE572204"
msgid "Wednesday,\nI thought that was yesterday..."
msgstr "Wednesday,\nI thought that was yesterday..."

#. Key:	2B2A843296614E769E79AADDA93B4FD8
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D06_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D06_L.Text
msgctxt ",2B2A843296614E769E79AADDA93B4FD8"
msgid "No need to.\nI'd rather stay away from her room.\nNo more problems, thanks."
msgstr "No need to.\nI'd rather stay away from her room.\nNo more problems, thanks."

#. Key:	BD2453C7448144C5842CE06F50D93290
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D08_L.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D08_L.0.Text
msgctxt ",BD2453C7448144C5842CE06F50D93290"
msgid "I'm tired, maybe i should take a rest."
msgstr "I'm tired, maybe i should take a rest."

#. Key:	95DD8510CE464093A95713E5148FFDBF
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D08_L.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D08_L.1.Text
msgctxt ",95DD8510CE464093A95713E5148FFDBF"
msgid "No way, at this rate we will <bold>never</> get out.\nJust do one more push."
msgstr "No way, at this rate we will <bold>never</> get out.\nJust do one more push."

#. Key:	C5F7B0836C9049CA9CE709BF993B81B5
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.0.Text
msgctxt ",C5F7B0836C9049CA9CE709BF993B81B5"
msgid "Shh, you're going to wake mom and dad."
msgstr "Shh, you're going to wake mom and dad."

#. Key:	7244B225926D497F86E562C2FB6E623E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.1.Text
msgctxt ",7244B225926D497F86E562C2FB6E623E"
msgid "I'm sorry i should have been more careful.\nI usually would have checked before."
msgstr "I'm sorry i should have been more careful.\nI usually would have checked before."

#. Key:	B9C9907E0AA44F3789A36F15F6B3ECA3
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.10.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.10.Text
msgctxt ",B9C9907E0AA44F3789A36F15F6B3ECA3"
msgid "Just stop wasting time and grow up for once."
msgstr "Just stop wasting time and grow up for once."

#. Key:	7A41471303DA492D82FFFC0CDC7274E2
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.2.Text
msgctxt ",7A41471303DA492D82FFFC0CDC7274E2"
msgid "You're very <bold>selfish</>.\nWhy don't you think about the rest of <bold>us</>?"
msgstr "You're very <bold>selfish</>.\nWhy don't you think about the rest of <bold>us</>?"

#. Key:	9C3D73FFDABE42B5BD2E64DFADB94014
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.3.Text
msgctxt ",9C3D73FFDABE42B5BD2E64DFADB94014"
msgid "If you wake them up they will be angry."
msgstr "If you wake them up they will be angry."

#. Key:	59AA6CA4A58B4D9E8A0DF8DF416513CD
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.4.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.4.Text
msgctxt ",59AA6CA4A58B4D9E8A0DF8DF416513CD"
msgid "i just... \nwanted to ...\ni tried ..."
msgstr "i just... \nwanted to ...\ni tried ..."

#. Key:	28F77DFB24834C88BE5D5A5284CDB2B7
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.5.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.5.Text
msgctxt ",28F77DFB24834C88BE5D5A5284CDB2B7"
msgid "Always you!\nYou're not the center of the universe, you know?!"
msgstr "Always you!\nYou're not the center of the universe, you know?!"

#. Key:	F125AFDE130745849D638AEBDBA418C3
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.6.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.6.Text
msgctxt ",F125AFDE130745849D638AEBDBA418C3"
msgid "Please, be quiet, you're going to wake them up."
msgstr "Please, be quiet, you're going to wake them up."

#. Key:	846D2FBC4439482CBE5DD821F0994274
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.7.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.7.Text
msgctxt ",846D2FBC4439482CBE5DD821F0994274"
msgid "It was too much, i just needed to find a way..."
msgstr "It was too much, i just needed to find a way..."

#. Key:	81AE5EB8058B47F18E3F72A9F8CD4073
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.8.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.8.Text
msgctxt ",81AE5EB8058B47F18E3F72A9F8CD4073"
msgid "Stop being such a whiney bitch.\nIt's not complicated, you know?\nWhy do you have to turn everything into a problem?"
msgstr "Stop being such a whiney bitch.\nIt's not complicated, you know?\nWhy do you have to turn everything into a problem?"

#. Key:	94E9A4BDD1124FBA82B366C5F0413E25
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.9.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.9.Text
msgctxt ",94E9A4BDD1124FBA82B366C5F0413E25"
msgid "(Why does everyone always fight?)"
msgstr "(Why does everyone always fight?)"

#. Key:	EDA95681D04B434DA7F9BB403DF0172A
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_Gun.Text
msgctxt ",EDA95681D04B434DA7F9BB403DF0172A"
msgid "What the fuck?!"
msgstr "What the fuck?!"

#. Key:	8B375D1BF7AA4359960F3589071BD62E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_L.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_L.1.Text
msgctxt ",8B375D1BF7AA4359960F3589071BD62E"
msgid "No way."
msgstr "No way."

#. Key:	81EA773A4BB740EA8294CBF24C9E3A68
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_L.Text
msgctxt ",81EA773A4BB740EA8294CBF24C9E3A68"
msgid "(I don't wanna go there.\nI don't want to tell Ray, he would drag me with him.\nSometimes i wish i had his courage, but without the consequences.)"
msgstr "(I don't wanna go there.\nI don't want to tell Ray, he would drag me with him.\nSometimes i wish i had his courage, but without the consequences.)"

#. Key:	B135E6BD1221417DAD00B6756451C4E6
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_T.0.Text
