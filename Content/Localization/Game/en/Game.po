msgstr "(Maybe i could convince Ray)"

#. Key:	A9CDABF9AD524503BD994105A72780E3
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_T.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_T.1.Text
msgctxt ",A9CDABF9AD524503BD994105A72780E3"
msgid "I think we could get out through that door..."
msgstr "I think we could get out through that door..."

#. Key:	1274091E9EC74C48BDCA9707D49D9655
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_T.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10_T.2.Text
msgctxt ",1274091E9EC74C48BDCA9707D49D9655"
msgid "I'm sick of being stuck.\nThat's it, let's go now!"
msgstr "I'm sick of being stuck.\nThat's it, let's go now!"

#. Key:	3B3CC662C2F943EE9F25F29C2EE7E52B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10xC00.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10xC00.0.Text
msgctxt ",3B3CC662C2F943EE9F25F29C2EE7E52B"
msgid "Let's get out of here.\nI'm sick."
msgstr "Let's get out of here.\nI'm sick."

#. Key:	4C207CD90B5B4054BAADF2B89CB5C150
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10xC00.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10xC00.1.Text
msgctxt ",4C207CD90B5B4054BAADF2B89CB5C150"
msgid "But... i'm not sure...\nI need to prepare!"
msgstr "But... i'm not sure...\nI need to prepare!"

#. Key:	868A8C59816F4FD6BD5B9FE7EC69B517
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10xC02.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/02/Diags02.Diags02.D10xC02.0.Text
msgctxt ",868A8C59816F4FD6BD5B9FE7EC69B517"
msgid "(It will surely bring problems,\nbut Ray is the only one who would dare to go.)"
msgstr "(It will surely bring problems,\nbut Ray is the only one who would dare to go.)"

