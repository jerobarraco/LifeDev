msgid "You're not the <i>only one</> with rights, <b>y'know?</>"
msgstr "You're not the <i>only one</> with rights, <b>y'know?</>"

#. Key:	D86C783247B8427BAB3DAD25607D2A18
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.C3S1.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.C3S1.3.Text
msgctxt ",D86C783247B8427BAB3DAD25607D2A18"
