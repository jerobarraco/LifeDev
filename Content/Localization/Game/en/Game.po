#. Key:	F441A54D66B64B01B53D6F64E0061EE5
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.Item.Look.C3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.Item.Look.C3.Text
msgctxt ",F441A54D66B64B01B53D6F64E0061EE5"
msgid "<b>Perseverance</>\n\"Perseverance, secret of all triumphs.\"\n\"If you are going through hell, keep going.\"\n\nI'm not sure we <i>can</>."
msgstr "<b>Perseverance</>\n\"Perseverance, secret of all triumphs.\"\n\"If you are going through hell, keep going.\"\n\nI'm not sure we <i>can</>."

#. Key:	DF95029C1F4F43CFA994555B3FCE1463
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.Item.Look.T03.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.Item.Look.T03.Text
msgctxt ",DF95029C1F4F43CFA994555B3FCE1463"
msgid "Kill noise with noise."
msgstr "Kill noise with noise."

#. Key:	D58CF06952C543FB88CD9B5243302E26
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.0.Text
msgctxt ",D58CF06952C543FB88CD9B5243302E26"
msgid "Looks like another poem."
msgstr "Looks like another poem."

#. Key:	821E93B231534988965354F2F99C7E5E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.1.Text
msgctxt ",821E93B231534988965354F2F99C7E5E"
msgid "\"It's not true that loneliness is so alone\nThe masks don't let us see the friendly hands\nWe look for help where there is none\nBlinded to accept the one offered to us\nMaybe in the dissapointment of not getting it from who we expect\nAnd infatuated we cloister ourselves,\nIgnoring the most valuable and silent presences\""
msgstr "\"It's not true that loneliness is so alone\nThe masks don't let us see the friendly hands\nWe look for help where there is none\nBlinded to accept the one offered to us\nMaybe in the dissapointment of not getting it from who we expect\nAnd infatuated we cloister ourselves,\nIgnoring the most valuable and silent presences\""

#. Key:	6A4A3814F03C43E3B09B6775D19ED5A4
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.2.Text
msgctxt ",6A4A3814F03C43E3B09B6775D19ED5A4"
msgid "\"In the face of discouragement, sadness, and absolute silence\nDon't ever hesitate to shout for help\nWilling to accept whomever presents in your way.\""
msgstr "\"In the face of discouragement, sadness, and absolute silence\nDon't ever hesitate to shout for help\nWilling to accept whomever presents in your way.\""

#. Key:	675E6BB268D14B7E971D03E903C5796D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.3.Text
msgctxt ",675E6BB268D14B7E971D03E903C5796D"
msgid "\"Life is many times hard, rough,\nBut the pain always passes,\nAlso existing many moments of big joy\nAnd so the days pass...\nThe deepest wounds, it is true, leave marks, but they heal, be born again.\nWe are never alone in these struggles\nWe only are so when we don't learn to ask for help.\""
msgstr "\"Life is many times hard, rough,\nBut the pain always passes,\nAlso existing many moments of big joy\nAnd so the days pass...\nThe deepest wounds, it is true, leave marks, but they heal, be born again.\nWe are never alone in these struggles\nWe only are so when we don't learn to ask for help.\""

#. Key:	3BD9BF8F04B740539C123471CC03A11D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.4.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.P03_Look.4.Text
msgctxt ",3BD9BF8F04B740539C123471CC03A11D"
msgid "\"And in each new foot print\nBuild a new walk,\nIt's always possible to walk again\nWithout loosing ourselves in resentment\nLearning to grow\nJust as we see the moon at dusk\nAnd after each night the light reborns again.\"\n\n- Paula Martìnez 05/02/2020"
msgstr "\"And in each new foot print\nBuild a new walk,\nIt's always possible to walk again\nWithout loosing ourselves in resentment\nLearning to grow\nJust as we see the moon at dusk\nAnd after each night the light reborns again.\"\n\n- Paula Martìnez 05/02/2020"

#. Key:	C40BC2AEF93749DA8A15FFD72F679691
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PIC01_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PIC01_T.Text
msgctxt ",C40BC2AEF93749DA8A15FFD72F679691"
msgid "I never understood those weird pictures.\nThey are scary."
msgstr "I never understood those weird pictures.\nThey are scary."

#. Key:	3F74DF914AF14F7293F7696CCA0C9781
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PL00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PL00_T.Text
msgctxt ",3F74DF914AF14F7293F7696CCA0C9781"
msgid "I think it's dying.\nSo sad..."
msgstr "I think it's dying.\nSo sad..."

#. Key:	0CE34CDEF0C44839864F944DA6F1D494
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03_T.Text
msgctxt ",0CE34CDEF0C44839864F944DA6F1D494"
msgid "\"SHAME\"\nUghh, i feel like i'm going to throw up.\nAnd all my blood just left my body."
msgstr "\"SHAME\"\nUghh, i feel like i'm going to throw up.\nAnd all my blood just left my body."

#. Key:	4D6213DA67814D6DA748260CC662741E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03xC00.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03xC00.Text
msgctxt ",4D6213DA67814D6DA748260CC662741E"
msgid "I just want things to be fine for a moment."
msgstr "I just want things to be fine for a moment."

#. Key:	1F3D288BD8D84C3FACEA0CCA6878E408
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03xC01.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03xC01.Text
msgctxt ",1F3D288BD8D84C3FACEA0CCA6878E408"
msgid "Maybe if i'm careful i can avoid making others upset."
msgstr "Maybe if i'm careful i can avoid making others upset."

#. Key:	C85B3351A39043C5B9DCC00994E38676
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03xC02.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ03xC02.Text
msgctxt ",C85B3351A39043C5B9DCC00994E38676"
msgid "I'm so tired of people telling me what i should or shouldn't be doing."
msgstr "I'm so tired of people telling me what i should or shouldn't be doing."

#. Key:	4556B34115B24AD8B58ADA4161DB96B8
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC00.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC00.Text
msgctxt ",4556B34115B24AD8B58ADA4161DB96B8"
msgid "Music is the only thing i can enjoy.\nThere was a song i knew, divided in 3 octaves."
msgstr "Music is the only thing i can enjoy.\nThere was a song i knew, divided in 3 octaves."

#. Key:	2D5C7B65390B4E92AD445DFD75D1F926
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC01.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC01.Text
msgctxt ",2D5C7B65390B4E92AD445DFD75D1F926"
msgid "Did that song end in the lowest octave?"
msgstr "Did that song end in the lowest octave?"

#. Key:	213A21ED3FD349018A9E70B8D5783B76
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC02.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC02.Text
msgctxt ",213A21ED3FD349018A9E70B8D5783B76"
msgid "Can't remember if the highest octave is actually used."
msgstr "Can't remember if the highest octave is actually used."

#. Key:	5802D42144CF457F8895AD3D1E5EF15D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC03.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ04xC03.Text
msgctxt ",5802D42144CF457F8895AD3D1E5EF15D"
msgid "The third is the second, i think."
msgstr "The third is the second, i think."

#. Key:	0D3CA836FF7440AF9FB66B47B0C0E186
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ06_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.PZ06_T.0.Text
msgctxt ",0D3CA836FF7440AF9FB66B47B0C0E186"
msgid "That picture makes me sad.\nI was scolded by mom just after this picture was taken."
msgstr "That picture makes me sad.\nI was scolded by mom just after this picture was taken."

#. Key:	C353EDBA858549CE9D831261D3C5B178
