#. Key:	51DE3549D6B14801B2CBAEC9288E0046
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Basin00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Basin00_T.Text
msgctxt ",51DE3549D6B14801B2CBAEC9288E0046"
msgid "Yet another thing to keep me awake.\nI wish that leak get fixed someday.\nI shouldn't be so whiney,\nIf only i could suck it up and don't complain."
msgstr "Yet another thing to keep me awake.\nI wish that leak get fixed someday.\nI shouldn't be so whiney,\nIf only i could suck it up and don't complain."

#. Key:	5E4E16AD30644E9697C09A8C30A7E895
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.BED00_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.BED00_L.Text
msgctxt ",5E4E16AD30644E9697C09A8C30A7E895"
msgid "I'm so tired i feel like i'll fall. \nBut this is my sister's bed.\nMy room is not too far, i think i'll make it."
msgstr "I'm so tired i feel like i'll fall. \nBut this is my sister's bed.\nMy room is not too far, i think i'll make it."

#. Key:	34464219079A4B1A85F8E113A468C9C4
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.C05_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.C05_T.Text
msgctxt ",34464219079A4B1A85F8E113A468C9C4"
msgid "I need to remember to wash some clothes.\nI'd like to do them all before mom comes back, but there's always more."
msgstr "I need to remember to wash some clothes.\nI'd like to do them all before mom comes back, but there's always more."

#. Key:	5197C5DB40B7414B9DA7DE44DC279F05
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.C06_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.C06_T.Text
msgctxt ",5197C5DB40B7414B9DA7DE44DC279F05"
msgid "I hate when they leave stuff on the floor.\nThey make mom upset."
msgstr "I hate when they leave stuff on the floor.\nThey make mom upset."

#. Key:	90F69E34207E400D8E75CD365E4DE4FF
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.C0_Pick.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.C0_Pick.Text
msgctxt ",90F69E34207E400D8E75CD365E4DE4FF"
msgid "<b>\"Intention\"</>\n\"Where Attention Goes, Energy Follows\"\n\nWhere did this come from?\nSounds like weird sorcery stuff."
msgstr "<b>\"Intention\"</>\n\"Where Attention Goes, Energy Follows\"\n\nWhere did this come from?\nSounds like weird sorcery stuff."

#. Key:	AF008CEF2AF040E8BBAB8051303EE899
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D03_LCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D03_LCK.Text
msgctxt ",AF008CEF2AF040E8BBAB8051303EE899"
msgid "No way i'm going outside again.\nIt's too dangerous, and i'm too tired.\nI need to sleep."
msgstr "No way i'm going outside again.\nIt's too dangerous, and i'm too tired.\nI need to sleep."

#. Key:	75BDE99ECFBB4146AAC9BF3DA2286FDA
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D04_LCK.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D04_LCK.Text
msgctxt ",75BDE99ECFBB4146AAC9BF3DA2286FDA"
msgid "Am i forgetting something?"
msgstr "Am i forgetting something?"

#. Key:	042599DB5DFB4298B2272FCA510D53BB
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D05_L.Basin.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D05_L.Basin.Text
msgctxt ",042599DB5DFB4298B2272FCA510D53BB"
msgid "I have to close that faucet or the noise won't let me sleep."
msgstr "I have to close that faucet or the noise won't let me sleep."

#. Key:	AC7A6A968E5E43009CD315CDF7B8EC3D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D05_L.C0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D05_L.C0.Text
msgctxt ",AC7A6A968E5E43009CD315CDF7B8EC3D"
msgid "Something fell from the clothes.\nI want to see it."
msgstr "Something fell from the clothes.\nI want to see it."

#. Key:	B8942398B2C6462AB79C8CDC57514F93
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D05_L.Spot.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.D05_L.Spot.Text
msgctxt ",B8942398B2C6462AB79C8CDC57514F93"
msgid "I need to put those clothes away, or my mom could wake me up angry."
msgstr "I need to put those clothes away, or my mom could wake me up angry."

#. Key:	0E50863D18D24D8F8AB7BCB180E765A0
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.0.Text
msgctxt ",0E50863D18D24D8F8AB7BCB180E765A0"
msgid "Nothing really of use here."
msgstr "Nothing really of use here."

#. Key:	801A57C9F07F4078A173BC52AA541C65
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*0.Text
msgctxt ",801A57C9F07F4078A173BC52AA541C65"
msgid "I just really want to go to sleep."
msgstr "I just really want to go to sleep."

#. Key:	18ADD799A50948E8B754EA4731682827
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*1.Text
msgctxt ",18ADD799A50948E8B754EA4731682827"
msgid "I wish i could find a magic solution here."
msgstr "I wish i could find a magic solution here."

#. Key:	F2956C2A58704D159565DF2F4D64CE67
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*2.Text
msgctxt ",F2956C2A58704D159565DF2F4D64CE67"
msgid "Just a boring drawer with boring drawer stuff."
msgstr "Just a boring drawer with boring drawer stuff."

#. Key:	9BCD9EEBD5AE43BD8F6BD3860EE80B95
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR00_T.1*3.Text
msgctxt ",9BCD9EEBD5AE43BD8F6BD3860EE80B95"
msgid "\"But you're still tired\"..."
msgstr "\"But you're still tired\"..."

#. Key:	1AFB26DCC0E84C3983654C970031F42F
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR01_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.DR01_T.Text
msgctxt ",1AFB26DCC0E84C3983654C970031F42F"
msgid "Maybe if i just keep searching..."
msgstr "Maybe if i just keep searching..."

#. Key:	7771F7492B724E3090D9071F2ACC352B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.HT02_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.HT02_L.Text
msgctxt ",7771F7492B724E3090D9071F2ACC352B"
msgid "It won't turn on, the starter is broken. Besides...\nIt's just below the window...\nHow did nobody realized?"
msgstr "It won't turn on, the starter is broken. Besides...\nIt's just below the window...\nHow did nobody realized?"

#. Key:	272ABB5BB2114391A1DDDA1714F49293
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.0.Text
msgctxt ",272ABB5BB2114391A1DDDA1714F49293"
msgid "My whole short life has always been like this..."
msgstr "My whole short life has always been like this..."

#. Key:	5B49E2DDD9144620924A6B91820E9063
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.1.Text
msgctxt ",5B49E2DDD9144620924A6B91820E9063"
msgid "How can they trust eachother?\nIt's better to stay away."
msgstr "How can they trust eachother?\nIt's better to stay away."

#. Key:	9F46D557D95D413BA38DDA5AC81F676D
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.2.Text
msgctxt ",9F46D557D95D413BA38DDA5AC81F676D"
msgid "I don't know why i'm here.\nOr who i am."
msgstr "I don't know why i'm here.\nOr who i am."

#. Key:	D217E79E6F9E4BB1B88FF7B7AE9C7FE9
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I0.3.Text
msgctxt ",D217E79E6F9E4BB1B88FF7B7AE9C7FE9"
msgid "All i know is that i don't fit in and i <bold>must</> escape or die."
msgstr "All i know is that i don't fit in and i <bold>must</> escape or die."

#. Key:	4B3AB090791844E4BD4B27EABB1CBA61
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.0.Text
msgctxt ",4B3AB090791844E4BD4B27EABB1CBA61"
msgid "I can't do it."
msgstr "I can't do it."

#. Key:	67FE8ED70800409C88C58F2CC0EA6501
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.1.Text
msgctxt ",67FE8ED70800409C88C58F2CC0EA6501"
msgid "I'm exhausted..."
msgstr "I'm exhausted..."

#. Key:	375ABB514B5D42C6AA93C059AB260F9B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.2.Text
msgctxt ",375ABB514B5D42C6AA93C059AB260F9B"
msgid "It's always the same, it will never change.\nI'm stuck, and nobody can help.\nThere's so much pain, it's even hard to breathe."
msgstr "It's always the same, it will never change.\nI'm stuck, and nobody can help.\nThere's so much pain, it's even hard to breathe."

#. Key:	577A43587EAB4A7E91EDE2B11A179B37
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.3.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.3.Text
msgctxt ",577A43587EAB4A7E91EDE2B11A179B37"
msgid "If i'm lucky i'll die while sleeping..."
msgstr "If i'm lucky i'll die while sleeping..."

#. Key:	EE28659ADD4047BE90DDBDF7466F4984
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.4.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.4.Text
msgctxt ",EE28659ADD4047BE90DDBDF7466F4984"
msgid "I give up.\nI don't know what else to do..."
msgstr "I give up.\nI don't know what else to do..."

#. Key:	9D3C0934BE20467297E776F9B3DD322F
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.5.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.I1.5.Text
msgctxt ",9D3C0934BE20467297E776F9B3DD322F"
msgid "God, you know i don't believe much in you, but if you do exist...\nPlease...\nGive me clarity..."
msgstr "God, you know i don't believe much in you, but if you do exist...\nPlease...\nGive me clarity..."

#. Key:	80DBE69C5CCA4AA58EEDF4710122FAD4
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_D*0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_D*0.Text
msgctxt ",80DBE69C5CCA4AA58EEDF4710122FAD4"
msgid "Dirty clothes go here."
msgstr "Dirty clothes go here."

#. Key:	36E73623E3B3420CA0919BA117C5F974
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_D*1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_D*1.Text
msgctxt ",36E73623E3B3420CA0919BA117C5F974"
msgid "I'm too tired...\nBut better not to leave them on the floor."
msgstr "I'm too tired...\nBut better not to leave them on the floor."

#. Key:	3D12BC3E04B543EC8CD0466B8A12EF66
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_D*2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_D*2.Text
msgctxt ",3D12BC3E04B543EC8CD0466B8A12EF66"
msgid "Smells like teen's clothes."
msgstr "Smells like teen's clothes."

#. Key:	C80D8C4818514C8C96DE76CD911F100B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_L.Text
msgctxt ",C80D8C4818514C8C96DE76CD911F100B"
msgid "I'll leave the clothes here for now, i'm too tired."
msgstr "I'll leave the clothes here for now, i'm too tired."

#. Key:	6353F519DA3D440988B1AA918A4BB79B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.IS0_T.Text
msgctxt ",6353F519DA3D440988B1AA918A4BB79B"
msgid "Finally, can go to sleep.\nUops, something just fell. What's that?"
msgstr "Finally, can go to sleep.\nUops, something just fell. What's that?"

#. Key:	918EEA446BDD4F7B8F34773AA7464694
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.BadTarget.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.BadTarget.Text
msgctxt ",918EEA446BDD4F7B8F34773AA7464694"
msgid "That's very creative.\nBut i can't use that with that."
msgstr "That's very creative.\nBut i can't use that with that."

#. Key:	2237A2E43ED74074BF42D3371109E216
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.NoTarget.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/00/Diags00.Diags00.Item.Fail.NoTarget.Text
msgctxt ",2237A2E43ED74074BF42D3371109E216"
msgid "Can't use it by itself.\nNothing's here."
msgstr "Can't use it by itself.\nNothing's here."

