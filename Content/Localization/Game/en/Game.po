#. Key:	1FF2C2E2E5914BF9ADD642615796D080
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Item.Fail.NoTarget.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Item.Fail.NoTarget.Text
msgctxt ",1FF2C2E2E5914BF9ADD642615796D080"
msgid "Nothing there to use it with."
msgstr "Nothing there to use it with."

#. Key:	4FC6451ACCBE49DD83E26668AC3FA127
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Item.Fail.NotReady.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Item.Fail.NotReady.Text
msgctxt ",4FC6451ACCBE49DD83E26668AC3FA127"
msgid "Might need to wait."
msgstr "Might need to wait."

#. Key:	928385ACF5254E1B85C92097398DA377
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Item.Fail.NotUsable.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Item.Fail.NotUsable.Text
msgctxt ",928385ACF5254E1B85C92097398DA377"
msgid "I can't think on a use for this."
msgstr "I can't think on a use for this."

#. Key:	6872FA70A17C4C6AB822DE194A56594E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Matches00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Matches00_T.Text
msgctxt ",6872FA70A17C4C6AB822DE194A56594E"
msgid "There are only a few left.\nWhat if they're just wet?"
msgstr "There are only a few left.\nWhat if they're just wet?"

#. Key:	B77D9E8888A543208CFE66B87F0A2676
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.NPCI06_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.NPCI06_T.Text
msgctxt ",B77D9E8888A543208CFE66B87F0A2676"
msgid "Maybe eating is a good idea.\nCould we eat something?"
msgstr "Maybe eating is a good idea.\nCould we eat something?"

#. Key:	871D2F59F9324299A37F77D7E4975D2A
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pic02_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pic02_T.0.Text
msgctxt ",871D2F59F9324299A37F77D7E4975D2A"
msgid "...\nThis picture always makes me sad.\nIt's like... they're making fun of me."
msgstr "...\nThis picture always makes me sad.\nIt's like... they're making fun of me."

#. Key:	75EDAF9245264C2392167C0E8C76029E
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pic02_T.1.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pic02_T.1.Text
msgctxt ",75EDAF9245264C2392167C0E8C76029E"
msgid "You <i>should</> try to accept them."
msgstr "You <i>should</> try to accept them."

#. Key:	2735404659694011B727C8E873ABA3CA
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pic02_T.2.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pic02_T.2.Text
msgctxt ",2735404659694011B727C8E873ABA3CA"
msgid "Yeah, accept that they are bad people and they won't change.\nBut I won't accept being treated like that."
msgstr "Yeah, accept that they are bad people and they won't change.\nBut I won't accept being treated like that."

#. Key:	0F668A953B8A452F8A93F27D2B778E70
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.0_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.0_L.Text
msgctxt ",0F668A953B8A452F8A93F27D2B778E70"
msgid "You <i>have</> to add <b>something</>, <i>y'know?</>"
msgstr "You <i>have</> to add <b>something</>, <i>y'know?</>"

#. Key:	07049AC905124F0B9091C80AB22E2416
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.0_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.0_T.Text
msgctxt ",07049AC905124F0B9091C80AB22E2416"
msgid "Ok, it's cooking now."
msgstr "Ok, it's cooking now."

#. Key:	268A74E28DDA4E4DB6C8EE28494D2C1B
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.1_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.1_L.Text
msgctxt ",268A74E28DDA4E4DB6C8EE28494D2C1B"
msgid "I <b>need</> a plate."
msgstr "I <b>need</> a plate."

#. Key:	76AC004315AB49AEB7EC234E3DF9AA89
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.1_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Pot00.1_T.Text
msgctxt ",76AC004315AB49AEB7EC234E3DF9AA89"
msgid "It's ready."
msgstr "It's ready."

#. Key:	60B5D9C7D5E842FCB5F6424FE15559C1
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Sponge00_T.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Sponge00_T.0.Text
msgctxt ",60B5D9C7D5E842FCB5F6424FE15559C1"
msgid "There's always a pile of plates, and that makes Mom angry.\nI don't want to have to do the dishes all the time.\nWhere do they all came from?"
msgstr "There's always a pile of plates, and that makes Mom angry.\nI don't want to have to do the dishes all the time.\nWhere do they all came from?"

#. Key:	0E887715D1574EB7A6080EF3C4426E50
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Stove00_L.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Stove00_L.Text
msgctxt ",0E887715D1574EB7A6080EF3C4426E50"
msgid "The matches <i>should</> be here.\nI don't understand why can't everyone be more organized."
msgstr "The matches <i>should</> be here.\nI don't understand why can't everyone be more organized."

#. Key:	22190DAC7B6F4BC2A171AACA7A5BF003
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Stove00_LI.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Stove00_LI.Text
msgctxt ",22190DAC7B6F4BC2A171AACA7A5BF003"
msgid "Try the matches..."
msgstr "Try the matches..."

#. Key:	0E18E044B069419583D71DE66A3FF8BA
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Stove00_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.Stove00_T.Text
msgctxt ",0E18E044B069419583D71DE66A3FF8BA"
msgid "It will boil soon.\nBut i need to add something to cook."
msgstr "It will boil soon.\nBut i need to add something to cook."

#. Key:	D5938DF7F0674A5690A0AD45EBA1673C
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.TV02_T.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/04/Diags04.Diags04.TV02_T.Text
msgctxt ",D5938DF7F0674A5690A0AD45EBA1673C"
msgid "I hate the tv while we're eating.\nWhy do we even bother to eat together if everyone is going to be distracted with some lousy shows?"
msgstr "I hate the tv while we're eating.\nWhy do we even bother to eat together if everyone is going to be distracted with some lousy shows?"

