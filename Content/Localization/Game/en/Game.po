msgstr "Oh no, a page fell."

#. Key:	F44111BAAAAA478D81AB264B9CCD2535
#. SourceLocation:	/Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.C3S1.0.Text
#: /Game/LifeDev/Game/Dialogs/Chaps/03/Diags03.Diags03.C3S1.0.Text
msgctxt ",F44111BAAAAA478D81AB264B9CCD2535"
msgid "Can you <i>please</> <b>stop</> making so much noise?"
msgstr "Can you <i>please</> <b>stop</> making so much noise?"

