
# report memory - https://forums.unrealengine.com/t/actor-tick-performance/380443/3?u=nande
MemReport -Log

# texture streaming
stat streaming
# also window> Statistics > Texture Stats
# on 5.x Tools > Audit > Statistics

# max fps
t.MaxFPS 120

# set ppol size
r.streaming.poolsize 2000


# show culling https://docs.unrealengine.com/5.0/en-US/visibility-and-occlusion-culling-in-unreal-engine/
stat initviews

# freeze rendering to debug culling
FreezeRendering

# profile gpu or ctrl+shift+comma
ProfileGPU


# call blueprint function on level blueprint https://forums.unrealengine.com/t/call-blueprint-event-from-console/9245/5
ce FunctionName par1 par2

# call bp function on any actor. actor name can be "*" to call on all of them
ke ActorName FunctionName par1 par2

r.MaxFPS 0 # disables?


# run on dual gpu

“C:\Program Files\Epic Games\UE_5.0EA\Engine\Binaries\Win64\UnrealEditor.exe” “C:\Users\Public\Documents\Unreal Projects\UE5Test\UE5Test.uproject” -game -d3d12 -MaxGPUCount=4 -VMGPU -AFR

# debug sounds by soloing ones by name
au.Debug.AudioSoloSoundWave wordtomatch

# debug asset loading
# https://docs.unrealengine.com/5.1/en-US/zen-loader-in-unreal-engine/
./LifeDev.sh -LogCmds="LogStreaming veryverbose"


# debug input, only avail on play in editor https://forums.unrealengine.com/t/command-to-debug-show-inputs-on-screen/461998/2
showdebug input

# hide texts https://forums.unrealengine.com/t/disable-all-screen-messages/84528/2
DISABLEALLSCREENMESSAGES
#re enable
ENABLEALLSCREENMESSAGES


# list objects
obj list -resourcesizesort
obj list class=SkeletalMesh -resourcesizesort
obj list class=StaticMesh -resourcesizesort

# garbage collection
OBJ GC
gc.CollectGarbageEveryFrame 1
GEngine->ForceGarbageCollection();
GetWorld()->ForceGarbageCollection(true);
# https://forums.unrealengine.com/t/force-garbage-collection/277172/2


# throttle annoying popup
Slate.TooltipSummonDelay 3

# audio mute
# https://dev.epicgames.com/documentation/en-us/unreal-engine/audio-console-commands-in-unreal-engine?application_version=5.3
au.Debug.SoloAudio
au.Debug.AudioSoloSoundClass
au.Debug.AudioSoloSoundCue
au.Debug.AudioSoloSoundWave
au.ClearMutesAndSolos


# DefaultEngine.ini, in the [SystemSettings] section (which you can add if it’s not already there), you can add “
# https://forums.unrealengine.com/t/seamless-travel-with-play-in-editor/394250/22
net.AllowPIESeamlessTravel=1