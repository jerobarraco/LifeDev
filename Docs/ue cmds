
# report memory - https://forums.unrealengine.com/t/actor-tick-performance/380443/3?u=nande
MemReport -Log

# texture streaming
stat streaming
# also window> Statistics > Texture Stats
# on 5.x Tools > Audit > Statistics

# max fps
t.MaxFPS 120

# set ppol size
r.streaming.poolsize 2000


# show culling https://docs.unrealengine.com/5.0/en-US/visibility-and-occlusion-culling-in-unreal-engine/
stat initviews

# freeze rendering to debug culling
FreezeRendering

# profile gpu or ctrl+shift+comma
ProfileGPU


# call blueprint function on level blueprint https://forums.unrealengine.com/t/call-blueprint-event-from-console/9245/5
ce FunctionName par1 par2

# call bp function on any actor. actor name can be "*" to call on all of them
ke ActorName FunctionName par1 par2

r.MaxFPS 0 # disables?
